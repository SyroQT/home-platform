{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": ["every weekend"],
  "prConcurrentLimit": 5,
  "flux": {
    "enabled": true
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/apps/.+\.yaml$/",
      "/platform/.+\.yaml$/"
    ]
  },
  "terraform": {
    "enabled": true
  },
  "dockerfile": {
    "managerFilePatterns": [
      "/bootstrap/docker/.+/Dockerfile$/"
    ]
  },
  "packageRules": [
    {
      "description": "Use widen range strategy for all Flux-managed Helm charts",
      "matchManagers": ["flux"],
      "rangeStrategy": "widen"
    },
    {
      "description": "No automerge for Helm minor and patch updates",
      "matchManagers": ["flux"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false
    },
    {
      "description": "Container image minor and patch updates - open PR, no automerge",
      "matchManagers": ["kubernetes"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false
    },
    {
      "description": "family-recipes builds are tagged master-<shortsha>-<unixtime>; order by timestamp, ignore latest and sha-* tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/ramintamisiunaite/family-recipes"],
      "versioning": "regex:^master-[a-f0-9]+-(?<patch>\\d+)$"
    },
    {
      "description": "Terraform provider/module updates",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false
    },
    {
      "description": "Major version bumps always require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update", "requires-review"]
    }
  ]
}
