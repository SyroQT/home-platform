#!/usr/bin/env bash
set -euo pipefail

set -a; source /etc/restic/env; set +a

BACKUP_PATH="{{ data_mount_point }}/k3s-local-path"

echo "[$(date -u +%FT%TZ)] Starting restic backup of ${BACKUP_PATH}"

restic backup "${BACKUP_PATH}" \
  --tag k3s-pvc \
  --exclude="*.tmp" \
  --exclude="*.lock"

restic forget \
  --keep-daily 7 \
  --keep-weekly 4 \
  --prune

echo "[$(date -u +%FT%TZ)] Backup complete"