hcloud_token              = "replace-me"
server_name               = "k3s-prod"
server_type               = "cpx22"
image                     = "ubuntu-22"
location                  = "nbg1"
ssh_public_key_path       = "~/.ssh/id_ed25519.pub"
allowed_ssh_cidr          = "203.0.113.10/32"
kube_api_allowed_cidrs    = ["203.0.113.10/32"]
volume_size_gb            = 50
object_storage_access_key = "<your-hetzner-s3-access-key>"
object_storage_secret_key = "<your-hetzner-s3-secret-key>"
backup_bucket_name        = "k3s-prod-backups"
